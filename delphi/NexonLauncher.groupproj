    </Target>
    <Target Name="nxl3p_shim:Clean">
        <MSBuild Projects="nxl3p_shim.dproj" Targets="Clean"/>
    </Target>
    <Target Name="nxl3p_shim:Make">
        <MSBuild Projects="nxl3p_shim.dproj" Targets="Make"/>
