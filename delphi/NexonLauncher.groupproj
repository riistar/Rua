<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{0462A7D1-602F-42D6-9D3C-582BB74EC759}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Rua.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="nxl3p_stub.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="nxl3p_shim.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Rua">
        <MSBuild Projects="Rua.dproj"/>
    </Target>
    <Target Name="Rua:Clean">
        <MSBuild Projects="Rua.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Rua:Make">
        <MSBuild Projects="Rua.dproj" Targets="Make"/>
    </Target>
    <Target Name="nxl3p_stub">
        <MSBuild Projects="nxl3p_stub.dproj"/>
    </Target>
    <Target Name="nxl3p_stub:Clean">
        <MSBuild Projects="nxl3p_stub.dproj" Targets="Clean"/>
